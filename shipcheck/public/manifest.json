{
  "manifest_version": 3,
  "name": "shipcheck",
  "version": "0.2.0",
  "description": "Checks whether a GitHub repo is ready to ship.",
  "action": {
    "default_popup": "index.html",
    "default_title": "shipcheck"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}